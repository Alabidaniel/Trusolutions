DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DATABASE"
PORT=4000

# Firebase Admin SDK (Service Account)
# Option A: point to a local service account JSON file.
FIREBASE_SERVICE_ACCOUNT_PATH="../trusolutionserviceaccount.json"

# Option B: provide credentials directly.
FIREBASE_PROJECT_ID="your-project-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxx@your-project-id.iam.gserviceaccount.com"
# Important: keep the literal \n sequences so the app can convert them to newlines.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n"
